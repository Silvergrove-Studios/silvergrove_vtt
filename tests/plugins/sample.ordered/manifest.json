{
  "id": "sample.ordered",
  "version": "0.1.0",
  "api": 1,
  "name": "Sample: ordered",
  "description": "An original, deliberately small ruleset with initiative, a d20 with three outcomes, conditions and hit points. Not a game anyone plays: the reference plugin that proves the API.",
  "license": "CC0-1.0",
  "attribution": "Sample rules by Silvergrove Studios, CC0.",
  "files": ["main.lua", "tests.lua"],
  "capabilities": ["state", "prompts", "log", "actions", "effects", "resources", "dice"],
  "policy": {"status": "best", "circumstance": "best"},
  "settings": {
    "schema": {"type": "object", "properties": {
      "critical_on": {"type": "integer", "minimum": 1, "maximum": 20, "title": "Natural roll that is a critical",
        "x-question": "rules", "x-notice": "everyone"},
      "armour_reduces": {"type": "integer", "title": "What a marked armour slot takes off a hit",
        "x-question": "outcomes", "x-levels": {"bookkeeping": 0, "rolling": 0, "assisted": 2, "automated": 2}, "x-notice": "everyone", "x-per-fight": true},
      "reach_checked": {"type": "boolean", "title": "Check reach",
        "x-question": "checks", "x-notice": "dm", "x-per-fight": true, "x-mind": false}}},
    "defaults": {"critical_on": 20, "armour_reduces": 2, "reach_checked": true}
  },
  "preferences": {
    "schema": {"type": "object", "properties": {
      "armour": {"type": "string", "enum": ["ask", "always", "never"], "title": "My armour when I'm hit",
        "enumNames": ["Ask me each time", "Always mark a slot", "Never: I'd rather keep it"],
        "x-when": {"armour_reduces": [1, 2, 3, 4, 5]}}}},
    "defaults": {"armour": "ask"}
  },
  "tests": true
}
